{"name": "is_even", "sig": "def is_even(n: int) -> bool:", "doc": "Return True if n is even.", "tests": ["assert is_even(2) is True", "assert is_even(3) is False", "assert is_even(0) is True"], "note": "奇偶判断"}
{"name": "reverse_string", "sig": "def reverse_string(s: str) -> str:", "doc": "Return s reversed.", "tests": ["assert reverse_string('abc') == 'cba'", "assert reverse_string('') == ''", "assert reverse_string('a') == 'a'"], "note": "字符串反转"}
{"name": "max_of_three", "sig": "def max_of_three(a: int, b: int, c: int) -> int:", "doc": "Return the largest of three ints.", "tests": ["assert max_of_three(1,5,3) == 5", "assert max_of_three(-1,-5,-3) == -1", "assert max_of_three(2,2,2) == 2"], "note": "三数最大"}
{"name": "count_vowels", "sig": "def count_vowels(s: str) -> int:", "doc": "Count vowels (aeiou) in s, case-insensitive.", "tests": ["assert count_vowels('hello') == 2", "assert count_vowels('AEIOU') == 5", "assert count_vowels('bcdfg') == 0"], "note": "元音计数"}
{"name": "fibonacci", "sig": "def fibonacci(n: int) -> int:", "doc": "Return the n-th Fibonacci number (0-indexed).", "tests": ["assert fibonacci(0) == 0", "assert fibonacci(1) == 1", "assert fibonacci(10) == 55"], "note": "斐波那契"}
{"name": "is_palindrome", "sig": "def is_palindrome(s: str) -> bool:", "doc": "Return True if s is a palindrome (ignore case and spaces).", "tests": ["assert is_palindrome('racecar') is True", "assert is_palindrome('No lemon no melon') is True", "assert is_palindrome('hello') is False"], "note": "回文判断"}
{"name": "sum_digits", "sig": "def sum_digits(n: int) -> int:", "doc": "Return the sum of digits of n.", "tests": ["assert sum_digits(123) == 6", "assert sum_digits(0) == 0", "assert sum_digits(999) == 27"], "note": "数位求和"}
{"name": "remove_duplicates", "sig": "def remove_duplicates(lst: list) -> list:", "doc": "Return a new list with duplicates removed, preserving order.", "tests": ["assert remove_duplicates([1,2,2,3]) == [1,2,3]", "assert remove_duplicates([]) == []", "assert remove_duplicates(['a','b','a']) == ['a','b']"], "note": "去重保序"}
{"name": "find_min", "sig": "def find_min(lst: list[int]) -> int:", "doc": "Return the minimum value in lst.", "tests": ["assert find_min([3,1,2]) == 1", "assert find_min([-5,-2,-9]) == -9", "assert find_min([7]) == 7"], "note": "最小值"}
{"name": "count_words", "sig": "def count_words(s: str) -> int:", "doc": "Return the number of words in s (split by whitespace).", "tests": ["assert count_words('hello world') == 2", "assert count_words('  a  b  c  ') == 3", "assert count_words('') == 0"], "note": "单词计数"}
{"name": "is_prime", "sig": "def is_prime(n: int) -> bool:", "doc": "Return True if n is prime (n >= 2).", "tests": ["assert is_prime(2) is True", "assert is_prime(9) is False", "assert is_prime(17) is True"], "note": "素数判断"}
{"name": "factorial", "sig": "def factorial(n: int) -> int:", "doc": "Return n! (0! = 1).", "tests": ["assert factorial(0) == 1", "assert factorial(5) == 120", "assert factorial(1) == 1"], "note": "阶乘"}
{"name": "gcd", "sig": "def gcd(a: int, b: int) -> int:", "doc": "Return the greatest common divisor of a and b.", "tests": ["assert gcd(12, 18) == 6", "assert gcd(7, 13) == 1", "assert gcd(0, 5) == 5"], "note": "最大公约数"}
{"name": "count_occurrences", "sig": "def count_occurrences(lst: list, target) -> int:", "doc": "Count how many times target appears in lst.", "tests": ["assert count_occurrences([1,2,3,2,2], 2) == 3", "assert count_occurrences([], 1) == 0", "assert count_occurrences(['a','a'], 'a') == 2"], "note": "元素计数"}
{"name": "capitalize_first", "sig": "def capitalize_first(s: str) -> str:", "doc": "Return s with the first character uppercased (if it is a letter).", "tests": ["assert capitalize_first('hello') == 'Hello'", "assert capitalize_first('') == ''", "assert capitalize_first('x') == 'X'"], "note": "首字母大写"}
{"name": "sum_list", "sig": "def sum_list(lst: list[int]) -> int:", "doc": "Return the sum of all elements in lst.", "tests": ["assert sum_list([1,2,3]) == 6", "assert sum_list([]) == 0", "assert sum_list([-1,1]) == 0"], "note": "列表求和"}
{"name": "is_sorted", "sig": "def is_sorted(lst: list) -> bool:", "doc": "Return True if lst is sorted in non-decreasing order.", "tests": ["assert is_sorted([1,2,3]) is True", "assert is_sorted([3,1,2]) is False", "assert is_sorted([]) is True"], "note": "有序判断"}
{"name": "to_binary", "sig": "def to_binary(n: int) -> str:", "doc": "Return the binary representation of n (without '0b' prefix).", "tests": ["assert to_binary(0) == '0'", "assert to_binary(5) == '101'", "assert to_binary(255) == '11111111'"], "note": "十进制转二进制"}
{"name": "starts_with", "sig": "def starts_with(s: str, prefix: str) -> bool:", "doc": "Return True if s starts with prefix.", "tests": ["assert starts_with('hello', 'he') is True", "assert starts_with('hello', '') is True", "assert starts_with('hello', 'lo') is False"], "note": "前缀判断"}
{"name": "swap_case", "sig": "def swap_case(s: str) -> str:", "doc": "Swap upper/lower case of each letter in s.", "tests": ["assert swap_case('Hello') == 'hELLO'", "assert swap_case('ABC') == 'abc'", "assert swap_case('123') == '123'"], "note": "大小写互换"}
